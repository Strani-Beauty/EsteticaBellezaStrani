# Supabase Configuration — copia este archivo como `.env` y rellena tus valores.
# NUNCA commitees `.env` (está en .gitignore).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe Configuration (publishable key)
STRIPE_PUBLISHABLE_KEY=

# Geocoding APIs (Opcional: Mapbox o Google Maps)
